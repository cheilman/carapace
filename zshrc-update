#!/usr/bin/env zsh
#
# Prepare to execute the Carapace generated zshrc script
#

# Profiling support
if [[ "$ZPROF" = true ]]; then
  zmodload zsh/zprof
fi

#
# Powerlevel10k instant prompt.
#
# Must come before anything that writes to the terminal or reads stdin, which
# is why it lives here rather than in the 40p10k module -- module fragments are
# concatenated well after this point.  Configured as "quiet" so the modules
# that do print at login (97fortunes) don't produce a warning.
#
# Disable by setting POWERLEVEL9K_INSTANT_PROMPT=off in ~/.p10k.zsh.
#
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

if which findCarapace &>/dev/null; then
  export CARAPACE="$(findCarapace)"
elif [ -x "${HOME}/bin/carapace/findCarapace" ]; then
  export CARAPACE="$(${HOME}/bin/carapace/findCarapace)"
elif [ -f "${HOME}/.carapace/CARAPACE" ]; then
  export CARAPACE="${HOME}/.carapace"
else
  echo "--!! FAILED TO FIND CARAPACE !!--"
fi

#
# Execute
#

[ -d "$CARAPACE" ] && source "${CARAPACE}/generated/generated-zshrc"

# Profiling support
if [[ "$ZPROF" = true ]]; then
  zprof
fi


#!zsh
#
# Functions for managing ssh-agent state
#

# Load https://github.com/wwalker/ssh-find-agent
source "${CARAPACE_CURRENT_MODULE_PATH}/ssh-find-agent.sh"

# Check if the agent is valid/running
function check-ssh-agent() {
  # `command` so this still works when the lazy wrappers below are in place.
  command ssh-add -l >&/dev/null
  result=$?

  # 0:  Everything is okay
  # 1:  Agent is up, but empty (no identities)
  # 2+: Can't talk to agent
  if [ $result -eq 0 -o $result -eq 1 ]; then
    return 0
  else
    return $result
  fi
}

# Add my common ssh keys
function ssh-add-my-keys() {
  # Add any with appropriate permissions
  return $(find ~/.ssh -perm 0600 | xargs ssh-add)
}

# Set up ssh
function ssh-setup() {
  # If a symlink for the socket exists, try that
  if SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock" check-ssh-agent; then
    export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
  else
    # Try to load an ssh agent
    ssh_find_agent -a
    if [ $? -ne 0 -o -z "$SSH_AUTH_SOCK" ]; then
      eval $(ssh-agent) > /dev/null
      # We could uncomment this to magically try to load keys on ssh, but let's leave it manual for now.
      #ssh-add -l >/dev/null || alias ssh='ssh-add -l >/dev/null || ssh-add-my-keys && unalias ssh; ssh'
    fi

    # Link it to a known location
    if test "$SSH_AUTH_SOCK" && check-ssh-agent; then
      ln -sf "${SSH_AUTH_SOCK}" "$HOME/.ssh/ssh_auth_sock"
      export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
    fi
  fi
}

alias ssh-prep='ssh-setup && ssh-add-my-keys'

#
# Agent discovery is deferred.
#
# ssh-setup runs ssh-add -l, sometimes ssh_find_agent, and sometimes spawns an
# agent -- ~20ms on every shell start, for something most shells never use.
# Instead, adopt an already-running agent cheaply if the well-known socket is
# there, and otherwise do the full discovery the first time an ssh-ish command
# is actually run.
#
# If you need SSH_AUTH_SOCK set unconditionally (a non-interactive script, say),
# call ssh-setup yourself.
#

if [[ -z "$SSH_AUTH_SOCK" && -S "$HOME/.ssh/ssh_auth_sock" ]]; then
  # Cheap: no forks, no agent spawn.  If the socket is stale the lazy wrapper
  # below will notice and redo the discovery properly.
  export SSH_AUTH_SOCK="$HOME/.ssh/ssh_auth_sock"
fi

_carapace_ssh_lazy_setup() {
  # Drop the wrappers first, so discovery below runs against the real binaries
  # and we only pay for it once per shell.
  unfunction ssh scp sftp ssh-add 2>/dev/null

  check-ssh-agent || ssh-setup
}

# NOTE: assign through $functions rather than `eval "ssh() { ... }"`.  30base
# aliases both ssh and scp, and an alias is expanded while the function
# definition is being parsed, so the eval form silently defines nothing.
for _cmd in ssh scp sftp ssh-add; do
  functions[$_cmd]="_carapace_ssh_lazy_setup; command $_cmd \"\$@\""
done
unset _cmd


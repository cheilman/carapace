#!/usr/bin/env zsh

#
# Aliases for toybox commands that don't exist on the system
#

moduledir="${1:-/dev/null}"
generateddir="${2:-/dev/null}"

#
# Figure out which toybox to use
#
# NOTE: arch-bin only carries x86_64 and aarch64 -- the other 16 architectures
# were 13MB of binaries for machines that don't exist.  Grab a build from
# https://landley.net/toybox/bin/ and drop it in if you need another.
#
# macOS reports arm64, but these are static *Linux* builds, so it deliberately
# does not map to toybox-aarch64.
machine="$(uname -m)"
if [ -x "${moduledir}/arch-bin/toybox-${machine}" ]; then
  carapace-redirect "${moduledir}/arch-bin/toybox-${machine}" "${moduledir}/bin/toybox"
else
  carapace-message "brown" "No toybox build for ${machine} in arch-bin/."
fi

if [ ! -x "${moduledir}/bin/toybox" ]; then
  carapace-message "brown" "No toybox binary for this architecture (${machine})."
  exit ${CARAPACE_SKIP:-42}
fi

#
# Figure out what commands we want to use
#

tb_alias_zshrc="${moduledir}/tbaliases"

cat > ${tb_alias_zshrc} <<EOF
#!zsh
#
# For commands that we like that aren't on the system, alias to our toybox install
#
# GENERATED FILE!! DO NOT EDIT
# $(date)
#

EOF

toyboxSupports() {
  local cmd="$1"

  for i in $(${moduledir}/bin/toybox); do
    if [ "$cmd" = "$i" ]; then
      return 0
    fi
  done

  return 1
}

toyboxCheckAndAlias() {
    local cmd="$1"

    # See if command exists
    command -v "$cmd" &> /dev/null
    if [ $? -eq 0 ]; then
        return
    fi

    # See if toybox supports the command
    toyboxSupports "$cmd" || return

    # Set up the alias
    echo "alias $cmd='toybox $cmd'" >> ${tb_alias_zshrc}
}

# Adds a lot of shit
for c in `toybox`; do
    toyboxCheckAndAlias $c
done

